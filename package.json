{
  "name": "formula-detailing-site",
  "private": true,
  "description": "Сайт FORMULA Detailing. Node нужен ТОЛЬКО для пересборки CSS (Tailwind); сам сайт — обычные html/css/js/php.",
  "scripts": {
    "build:css": "tailwindcss -i assets/css/src/input.css -o assets/css/style.css --minify",
    "watch:css": "tailwindcss -i assets/css/src/input.css -o assets/css/style.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.2.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0"
  }
}
